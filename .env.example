# Postgres: one database, one schema for every tenant.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=crypto_research_test

# The one schema every tenant's rows live in. Created when absent.
# SCHEMA=crypto_agent

# Session workspaces become <SANDBOX_ROOT>/session-<id>.
SANDBOX_ROOT=./dev/sandbox

# Project skills: each direct child directory containing SKILL.md is available to the agent.
SKILLS_ROOT=./skills

# 代码执行 sandbox 的运行方式：host（默认，dev / local 直接在主机执行）
# 或 docker（生产：一次性容器，无网络、无凭证，内存 / CPU 配额）。
# docker 模式必须给出 CODE_SANDBOX_IMAGE，镜像需预先 docker pull，自带 bash、python3 与 node。
# CODE_SANDBOX_MODE=docker
# CODE_SANDBOX_IMAGE=python:3.12-slim
# CODE_SANDBOX_MEMORY=512m
# CODE_SANDBOX_CPUS=1

HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# 日志：LOG_LEVEL 可选 DEBUG、INFO、WARNING、ERROR，默认 INFO。
# LOG_FORMAT 可选 auto、json、text，默认 auto：交互终端输出可读文本，其余场合输出 JSON；
# 文件一律写 JSON 行，文件名为 agent.log。
LOG_LEVEL=INFO
LOG_FORMAT=auto
# LOG_DIR 是文件日志的目录；两个开关分别控制控制台与文件输出。
LOG_DIR=./logs
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true
# 写文件的内存队列长度：队列写满时丢弃新记录并计数，下一条成功写入时补一条 WARNING。
LOG_QUEUE_SIZE=10000
# 单个文件超过 LOG_FILE_MAX_BYTES 就轮转：agent.log 改名 agent.log.1，旧编号依次后移，
# 最多保留 LOG_FILE_BACKUP_COUNT 个备份；进程占用约为 (备份数 + 1) × 该大小。
LOG_FILE_MAX_BYTES=20971520
LOG_FILE_BACKUP_COUNT=14

# JSON 配置：tenantId 对应独立的 Bearer token，每个 token 至少包含 32 个字符。
TENANT_TOKENS={"local":"4be631af53da62f316f48fe9b7ca64a9c55c78b652f67f3d"}

# 注册登录的 JWT 签名密钥：至少 32 个字符，生产环境使用随机值并保密。
AUTH_JWT_SECRET=
# 登录 token 的有效期（秒），默认 86400（24 小时）。
AUTH_JWT_TTL_SECONDS=86400

# provider/id, must exist in the catalog file.
DEFAULT_MODEL=
CATALOG_PATH=./model_providers.json

# Firecrawl 网页搜索和网页读取；留空时相关工具会返回配置错误。
FIRECRAWL_API_KEY=

# Serve the built frontend from this directory. Omit to serve the API only.
WEB_DIST=./packages/web/dist

# xapi 动作网关的 API key（https://www.xapi.to）；留空时 xapi-get / xapi-call 工具返回配置错误。
XAPI_API_KEY=